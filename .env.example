# ============================================================
# Polymarket Agents — Variáveis de Ambiente
# ============================================================
# Copie este arquivo: cp .env.example .env
# Em paper trading mode, apenas NEWSAPI_KEY é recomendada.
# A POLYGON_WALLET_PRIVATE_KEY só é necessária para live trading.

# --- LLM ---
# O bot usa Gemini CLI via OAuth (sem API key).
# Instale: npm install -g @google/gemini-cli
# Autentique: gemini   (abre o browser para login com conta Google na 1ª vez)

# --- Dados de mercado (opcionais, melhoram qualidade das predições) ---
# Obtenha em: https://newsapi.org/
NEWSAPI_API_KEY=""

# Obtenha em: https://tavily.com/
TAVILY_API_KEY=""

# --- Carteira Polygon (SOMENTE para live trading, não necessário em paper) ---
# ATENCAO: Leia os ToS antes de usar: https://polymarket.com/tos
POLYGON_WALLET_PRIVATE_KEY=""
